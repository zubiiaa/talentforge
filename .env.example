# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/talentforge?retryWrites=true&w=majority"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Vercel Blob (auto-provisioned when you link the Vercel project; needed for uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
